# Environment Configuration Template
PORT=8000
NODE_ENV=development

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/royalsquare_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-placeholder-service-key

# Cryptography & Security
AES_ENCRYPTION_MASTER_KEY=your-32-byte-hex-placeholder
JWT_SECRET=your-jwt-secret-placeholder

# Regulatory & Logging
LOG_LEVEL=info