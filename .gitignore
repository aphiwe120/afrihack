# ==============================================================================
# Royal Square Financial - Backend .gitignore
# FSP No: 29370 | Strict POPIA & Cryptographic Protection
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Critical Security, Secrets & POPIA Data (NEVER COMMIT)
# ------------------------------------------------------------------------------
# Environment variables containing DB credentials, JWT secrets, and provider keys
.env
.env.*
!.env.example
!.env.template

# Cryptographic private keys, certificates, and auth secrets
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_ed25519

# Cloud & Infrastructure Service Credentials
service-account*.json
credentials.json
*supabase*secret*
*firebase*adminsdk*.json
aws-credentials
.aws/

# ------------------------------------------------------------------------------
# 2. Local Sensitive Data & Uploaded Evidence Blobs
# ------------------------------------------------------------------------------
# Prevent accidental commits of test client IDs, voice notes, or licence photos
uploads/
storage/
media/
evidence/
temp/
tmp/
*.dump
*.sql
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# 3. Language & Runtime Artifacts
# ------------------------------------------------------------------------------
# Node.js / TypeScript (if using Node/Express/Nest)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.tsbuildinfo

# Python (if using FastAPI/Django)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt

# Java / JVM (if using Spring/Ktor)
target/
*.class
*.jar
*.war
.gradle/

# Go
bin/
pkg/

# ------------------------------------------------------------------------------
# 4. Logs, Diagnostics & Local Caches
# ------------------------------------------------------------------------------
logs/
*.log
*.pid
*.seed
*.pid.lock
.pnpm-store/

# ------------------------------------------------------------------------------
# 5. Testing & Code Quality Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
.coverage
htmlcov/
*.lcov

# ------------------------------------------------------------------------------
# 6. IDEs, Operating System & Workspace Files
# ------------------------------------------------------------------------------
# OS-specific clutter
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Editor configurations (keep instructions, ignore local state)
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~